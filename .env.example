# ──────────────────────────────────────────────────────────────
#  Stack IA — variáveis de ambiente
#  Copie este arquivo para .env e ajuste os valores antes de subir.
#  Para automação total: veja AUTOMATION_SECTION.md
# ──────────────────────────────────────────────────────────────

# ── Portas ────────────────────────────────────────────────────
REDIS_PORT=6379
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
AI_MEMORY_PORT=49374
WEBUI_PORT=3000

# ── Modelo LLM padrão (usado pelo Open Web UI e OpenHands) ────
# Exemplo: gpt-4o-mini, claude-3-haiku, gemini-2.0-flash, etc.
# Sem IA local (Ollama), você precisará colocar chaves de API
# dos provedores (OpenAI, Anthropic, Google, Groq, OpenRouter, etc.)
LLM_MODEL=gpt-4o-mini

# ── Configuração do OmniRoute ─────────────────────────────────
# Branch do OmniRoute
OMNIROUTE_BRANCH=release/v3.8.49
# Caminho base (deixe vazio na maioria dos casos)
OMNIROUTE_BASE_PATH=
# API key de segurança do WebSocket do OmniRoute (gerar: openssl rand -hex 32)
OMNIROUTE_WS_BRIDGE_SECRET=

# ── Autenticação do OmniRoute ──────────────────────────────────
# Senha inicial do dashboard (definir uma senha forte)
INITIAL_PASSWORD=change-me-to-a-strong-password
# Token de segurança (gerar: openssl rand -hex 32)
AUTH_TOKEN=change-me-to-a-strong-token

# ── Autenticação (ALTERAR antes de usar em rede) ──────────────
AI_MEMORY_AUTH_TOKEN=troque-por-um-token-secreto

# ── Provedores de IA (configurados via dashboard em :20128) ──
# Você pode adicionar chaves de API dos provedores abaixo:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
# DEEPSEEK_API_KEY=...

# ──────────────────────────────────────────────────────────────