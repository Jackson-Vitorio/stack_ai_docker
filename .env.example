# ──────────────────────────────────────────────────────────────
#  Stack IA — variáveis de ambiente
#  Copie este arquivo para .env e ajuste os valores antes de subir.
# ──────────────────────────────────────────────────────────────

# ── Portas ────────────────────────────────────────────────────
REDIS_PORT=6379
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
AI_MEMORY_PORT=49374
WEBUI_PORT=3000

# ── Modelo LLM padrão (usado pelo Open Web UI e OpenHands) ────
# Exemplo: gpt-4o-mini, claude-3-haiku, etc.
# Como não há IA local (Ollama), você precisa colocar as chaves
# de API dos provedores (OpenAI, Anthropic, Google, etc.) no OmniRoute.
LLM_MODEL=gpt-4o-mini

# ── Branch do OmniRoute (deixe padrão se não souber) ──────────
OMNIROUTE_BRANCH=release/v3.8.49

# ── Caminho base do OmniRoute (deixe vazio na maioria dos casos) ──
OMNIROUTE_BASE_PATH=

# ── Autenticação (ALTERAR antes de usar em rede) ──────────────
AI_MEMORY_AUTH_TOKEN=troque-por-um-token-secreto
LLM_API_KEY=dummy

# ──────────────────────────────────────────────────────────────