# ──────────────────────────────────────────────────────────────
#  Stack IA — .gitignore
# ──────────────────────────────────────────────────────────────

# ── Segredos e config local ───────────────────────────────────
.env
.env.local
.env.*.local

# ── Dados de runtime (criados pelo Docker Compose) ────────────
data/
ollama/
qdrant-data/
redis-data/

# ── Workspace do agente OpenHands (não versionar trabalho) ────
projetos/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node / dependências ───────────────────────────────────────
node_modules/
.pnpm-store/
.npm/
.yarn/

# ── Build / cache ─────────────────────────────────────────────
.cache/
*.tsbuildinfo
dist/
build/
.next/

# ── IDE / OS ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Git ───────────────────────────────────────────────────────
.git/

# ── Docker ────────────────────────────────────────────────────
*.dockerignore

# ──────────────────────────────────────────────────────────────
# ── Workspace do agente OpenHands (não versionar trabalho) ────
projetos/
openhands-data/