# Dockerfile.omniroute
# Clona o código-fonte do OmniRoute durante o build e gera a imagem runner-base.
# Você não precisa clonar o repositório manualmente.

FROM node:20-alpine AS deps

# Ferramentas necessárias para build de alguns pacotes native
RUN apk add --no-cache git python3 make g++

# Clona o OmniRoute (branch release estável)
ARG OMNIROUTE_BRANCH=release/v3.8.49
RUN git clone --depth 1 --branch "${OMNIROUTE_BRANCH}" https://github.com/diegosouzapw/OmniRoute.git /app/omniroute

WORKDIR /app/omniroute
RUN npm ci

# ----------------------------------------------------------------
# Estágio runner: imagem final enxuta com o OmniRoute já construído
# ----------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

# Copia o código já com node_modules instalado
COPY --from=deps /app/omniroute /app/omniroute

WORKDIR /app/omniroute

# Variáveis de ambiente usadas pelo OmniRoute
ENV DATA_DIR=/app/data
ENV OMNIROUTE_BASE_PATH=""
ENV PORT=20128
ENV DASHBOARD_PORT=20128
ENV API_PORT=20129
ENV API_HOST=0.0.0.0
ENV LIVE_WS_PORT=20132
ENV LIVE_WS_HOST=0.0.0.0
ENV REDIS_URL=redis://redis:6379

# Volume de dados (montado no compose via ./data/omniroute)
VOLUME ["/app/data"]

# Portas do OmniRoute
EXPOSE 20128 20129 20132

# Healthcheck simples
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
  CMD node healthcheck.mjs || exit 1

# Entrypoint padrão do OmniRoute (ajuste se o repositório mudar o nome do script)
CMD ["node", "index.mjs"]