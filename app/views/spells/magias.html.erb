<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Título da Página</title>
</head>
<link rel="stylesheet" href="spells/styles">
<body>

<h1>Pesquisar Magias</h1>

<%= form_tag('/spells/magias', method: 'get') do %>
  <label for="spell_name">Nome da Magia (use > - < como espaço):</label>
  <%= text_field_tag 'spell_name', params[:spell_name], placeholder: 'Nome da Magia' %>
  <%= submit_tag 'Pesquisar' %>
<% end %>

<% if @spell_data.present? %>
  <h2>Resultado da Pesquisa</h2>
  <p><strong>Nome:</strong> <%= @spell_data['name'] %></p>
  <p><strong>Descrição:</strong> <%= @spell_data['description'] %></p>
  <p><strong>Tempo de Cast:</strong> <%= @spell_data['casting_time'] %></p>

  <% if @spell_data['components'].include?('M') %>
    <p><strong>Componente M (Material):</strong> <%= @spell_data['material'] %></p>
  <% end %>
<% end %>

<li><a href="/spells/centro">Voltar</a></li>
</body>
</html>
