<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Título da Página</title>
</head>
<link rel="stylesheet" href="spells/styles">
<body>
<h1>Pesquisar Monstros</h1>

<%= form_tag('/spells/monstros', method: 'get') do %>
  <label for="monster_name">Nome do Monstro:</label>
  <%= text_field_tag 'monster_name', params[:monster_name], placeholder: 'Nome do Monstro' %>
  <%= submit_tag 'Pesquisar' %>
<% end %>

<% if @monster_data.present? %>
  <h2>Resultado da Pesquisa</h2>
  <p><strong>Nome:</strong> <%= @monster_data['name'] %></p>
  <p><strong>Tamanho:</strong> <%= @monster_data['size'] %></p>
  <p><strong>Tipo:</strong> <%= @monster_data['type'] %></p>
  <p><strong>Armadura:</strong> <%= @monster_data['armor_class'] %></p>
  <p><strong>Pontos de Vida:</strong> <%= @monster_data['hit_points'] %></p>

  <% if @monster_data.key?('actions') %>
    <h3>Ações</h3>
    <ul>
      <% @monster_data['actions'].each do |action| %>
        <li><%= action['name'] %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<li><a href="/spells/centro">Voltar</a></li>
</body>
</html>
