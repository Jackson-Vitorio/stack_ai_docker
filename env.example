# =====================================================================
#  Stack IA — variáveis de ambiente (modelo)
#
#  Como usar:
#    1. ./scripts/setup-auto.sh   (cria o .env a partir deste arquivo e
#       gera todos os segredos marcados "auto")
#    2. ou manualmente: cp .env.example .env && chmod 600 .env
#       e preencha os campos vazios com: openssl rand -hex 32
#
#  Regras:
#    - NUNCA commite o .env (o setup-auto.sh já o coloca no .gitignore).
#    - Deixe os segredos VAZIOS aqui: valores de exemplo como "change-me"
#      acabariam sendo usados de verdade.
#    - Evite espaços e caracteres especiais nos valores.
# =====================================================================


# ── OmniRoute (roteador de LLMs) ─────────────────────────────────────

# Criptografa as credenciais dos provedores guardadas em ./data/omniroute. (auto)
# FAÇA BACKUP desta chave: sem ela, o que já foi salvo fica ilegível.
# Se já existem dados em ./data/omniroute, use a MESMA chave de antes.
STORAGE_ENCRYPTION_KEY=

# Senha inicial do dashboard em http://localhost:20128 (auto)
INITIAL_PASSWORD=

# Segredo do bridge WebSocket do OmniRoute (auto)
OMNIROUTE_WS_BRIDGE_SECRET=

# Chave que o Open WebUI e o Open Code usam para chamar o OmniRoute.
# "dummy" serve se o OmniRoute não exigir chave; se exigir, cole aqui
# uma chave criada no dashboard.
OMNIROUTE_API_KEY=dummy


# ── Redis (cache/estado do OmniRoute) ────────────────────────────────

# Senha do Redis (auto)
REDIS_PASSWORD=


# ── Akita AI Memory (memória de contexto + servidor MCP) ─────────────

# Token exigido por http://localhost:49374/mcp (auto)
AI_MEMORY_AUTH_TOKEN=


# ── Open WebUI (chat) ────────────────────────────────────────────────

# Chave de assinatura das sessões (auto)
WEBUI_SECRET_KEY=


# ── Open Code (agente com interface web) ─────────────────────────────

# Login pedido pelo navegador em http://localhost:3001
OPENCODE_SERVER_USERNAME=opencode
# Use uma senha forte. Se trocar depois, atualize também a senha salva
# no navegador e na chave da conexão em Settings > Servers. (auto)
OPENCODE_SERVER_PASSWORD=


# =====================================================================
#  Referência (não são variáveis; nada a preencher abaixo)
# =====================================================================
#
#  Portas publicadas — fixas no docker-compose.yml e ligadas a 127.0.0.1
#  (acessíveis só nesta máquina):
#
#    3000   Open WebUI              3001   Open Code
#    20128  OmniRoute (dashboard)   20129  OmniRoute (API /v1)
#    20132  OmniRoute (WebSocket)   49374  Akita AI Memory (MCP)
#    6333   Qdrant (HTTP)           6334   Qdrant (gRPC)
#    6379   Redis
#
#  Para mudar uma porta ou liberar o acesso à rede local, edite "ports:"
#  no docker-compose.yml. Antes de tirar o 127.0.0.1, confirme que as
#  senhas acima são fortes: sem elas, qualquer pessoa na rede entra.
#
#  Provedores de IA (OpenAI, Anthropic, Google, Groq, OpenRouter, etc.):
#  NÃO ficam neste arquivo. Cadastre as chaves no dashboard do OmniRoute
#  (http://localhost:20128); elas são guardadas criptografadas com a
#  STORAGE_ENCRYPTION_KEY acima.
#
#  Modelo padrão: escolhido na própria interface (Open WebUI ou Open Code),
#  por exemplo "auto/coding" do OmniRoute. Não há variável para isso.
# =====================================================================
